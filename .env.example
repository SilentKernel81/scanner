# ============================================================================
# Card Scanner Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================================

# AI Provider Selection (can also be set in config.yaml)
# Options: gemini, openai, anthropic, local
# VISION_AI_PROVIDER=gemini

# ============================================================================
# API Keys - Add your keys here
# ============================================================================

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic API Key (get from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ============================================================================
# Local AI Configuration (for Ollama or other local servers)
# ============================================================================

# Local AI endpoint - overrides vision_ai.local.endpoint in config.yaml
# LOCAL_AI_ENDPOINT=http://192.168.1.20:11434/v1/chat/completions
# (The model is picked in the web interface: Settings -> Vision AI)

# ============================================================================
# Who can reach and change the server
# ============================================================================

# Docker only: publish the web port on one address of this machine instead of all of them.
# 127.0.0.1 = only this computer (then no station, phone or other computer can connect);
# a LAN address = only that network card. Unset: every address, as before.
# SCANNER_BIND=127.0.0.1

# An optional password for the actions that can hurt (AI keys, restart, network access,
# debug mode, restoring / downloading backups). Normally chosen in Settings -> Server;
# set here to fix it from outside (then it cannot be changed in the page).
# SCANNER_SETTINGS_PASSWORD=

# ============================================================================
# Notes
# ============================================================================
# - Environment variables override config.yaml settings
# - You only need to set keys for the AI providers you plan to use
# - For local AI, make sure Ollama is running: ollama serve
# - The web UI allows switching providers without restart
# - Restart the scanner after editing this file (sudo systemctl restart mtg-scanner)
