# What Git leaves alone in this project. Everything a running scanner writes is in data/,
# scanned_cards/ and station_captures/ (see data/README.txt): none of it belongs in Git.

# --- Python ---
__pycache__/
*.py[cod]
venv/

# --- The server's data (data/README.txt stays in Git, the rest does not) ---
# Card data and, in the same file, the collection, decks and review queue
data/cards_database.db
# Scanned cards, captures waiting to be read, pictures, backups, uploads
data/scan_inventory.db*
data/pending_captures.db*
data/captures/
data/review/
data/backups/
data/uploads/
data/debug_frames/
# Exports written here by older versions
data/card_inventory.csv
data/card_inventory_export_*.csv
data/moxfield_export_*.csv
# Everyone's choices, each station's settings, edited prompts
data/settings.json
data/stations.json
data/prompts.json
# Answers of other sites, cached: disposable, rebuilt as needed
data/web_cache.db*
# SQLite's files beside a database in use
*.db-journal
*.db-wal
*.db-shm
# Logs
data/logs/
*.log

# --- A camera station's own files ---
# Its saved settings (can hold the server's token) and its setup page's password hash
data/station.json
data/station_login.json
# Captures that are not on the server yet
station_captures/

# --- Capture pictures the server received ---
scanned_cards/*.jpg
scanned_cards/*.jpeg
scanned_cards/*.png
scanned_cards/*.upload.json

# --- Secrets ---
# API keys and station settings for Docker (see .env.example, .env.station.example)
.env
.env.local
.env.*.local
# ... but not this link to it: Docker Compose looks for .env beside the compose files
!deploy/.env
# API keys entered in the web interface
data/api_keys.env
data/secret_key
data/app.lock
*_api_key.txt
secrets.txt

# --- The OCR reader's packages (npm install in src/ocr/) ---
node_modules/

# --- Archives made here ---
# scripts/backup.sh writes to ~/scanner-backups, but a copy may be put here
scanner-backup-*.tar.gz

# --- Editors, operating systems ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Kept on this machine only ---
# Claude Code's local settings (allowed commands can contain API keys)
.claude/settings.local.json
# Review notes, not part of the project
CODE_REVIEW.md
