[Unit]
Description=MTG Card Scanner Web Service
Documentation=https://github.com/your-repo/scanner
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/scanner

# Environment
Environment="PATH=/home/pi/scanner/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Load environment variables from .env file (if it exists)
EnvironmentFile=-/home/pi/scanner/.env

# Start command
ExecStart=/home/pi/scanner/venv/bin/python3 /home/pi/scanner/app.py

# Restart policy
Restart=always
RestartSec=10

# Stop command
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/scanner/data /home/pi/scanner/scanned_cards

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

# Logging
StandardOutput=append:/home/pi/scanner/data/logs/service.log
StandardError=append:/home/pi/scanner/data/logs/service-error.log
SyslogIdentifier=mtg-scanner

[Install]
WantedBy=multi-user.target
